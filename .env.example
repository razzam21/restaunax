# =============================================================================
# RESTAUNAX CONSOLIDATED ENVIRONMENT CONFIGURATION
# =============================================================================
# Copy this file to .env and update values for your environment
# This single file contains all environment variables for the entire application
# No need to manage separate .env files in client/ and server/ directories

# =============================================================================
# DOCKER COMPOSE CONFIGURATION
# =============================================================================
# Database Configuration for PostgreSQL Container
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=restaunax

# Environment
NODE_ENV=development

# =============================================================================
# NETWORK CONFIGURATION
# =============================================================================
# Client (Frontend) Configuration
CLIENT_PORT=3000
CLIENT_HOST=0.0.0.0

# Server (Backend) Configuration  
SERVER_PORT=8080
SERVER_INTERNAL_PORT=8080
SERVER_EXTERNAL_PORT=8081

# Database Ports
POSTGRES_PORT=5432
REDIS_PORT=6379

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
# Database URLs (constructed from above values)
# For Docker containers (services communicate via container names)
DATABASE_URL=postgresql://postgres:postgres@db:5432/restaunax

# For local development (outside Docker)
DATABASE_URL_LOCAL=postgresql://postgres:postgres@localhost:5432/restaunax

# =============================================================================
# REDIS CONFIGURATION
# =============================================================================
# Redis URLs (constructed from above values)
REDIS_URL=redis://redis:6379
REDIS_URL_LOCAL=redis://localhost:6379
REDIS_HOST=redis
REDIS_HOST_LOCAL=localhost
REDIS_PASSWORD=
REDIS_DB=0

# =============================================================================
# API CONFIGURATION
# =============================================================================
# Backend API URL for frontend (constructed from above values)
REACT_APP_API_URL=http://localhost:8081/api

# CORS Configuration (constructed from above values)
CORS_ORIGIN=http://localhost:3000

# =============================================================================
# SECURITY CONFIGURATION
# =============================================================================
# JWT Configuration
# IMPORTANT: Change these secrets in production!
JWT_ACCESS_SECRET=your-secure-access-secret-key-here
JWT_REFRESH_SECRET=your-secure-refresh-secret-key-here
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Password Hashing
BCRYPT_SALT_ROUNDS=12

# =============================================================================
# DEVELOPMENT CONFIGURATION
# =============================================================================
# React Development Settings
GENERATE_SOURCEMAP=true
WATCHPACK_POLLING=true
HOST=0.0.0.0

# Logging
LOG_LEVEL=info

# =============================================================================
# AI FEATURES (OPTIONAL)
# =============================================================================
# Master AI feature flag - must be true for any AI features to work
AI_ENABLED=false

# AI Engine Selection - at least one engine must be enabled when AI_ENABLED=true
# You can enable both engines and the system will use them as configured

# Ollama Configuration (Local AI)
OLLAMA_ENABLED=false
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
OLLAMA_TIMEOUT=30000

# OpenAI Configuration (Cloud AI)
OPENAI_ENABLED=false
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4
OPENAI_TIMEOUT=120000
OPENAI_MAX_TOKENS=2000

# AI Engine Priority (when both are enabled)
# Options: "ollama", "openai", "auto" (auto will choose based on availability)
AI_PRIMARY_ENGINE=ollama

# =============================================================================
# PRODUCTION OVERRIDES
# =============================================================================
# Uncomment and modify for production deployment
# NODE_ENV=production
# JWT_ACCESS_SECRET=your-production-access-secret
# JWT_REFRESH_SECRET=your-production-refresh-secret
# POSTGRES_PASSWORD=your-production-db-password
# OLLAMA_ENABLED=false

# =============================================================================
# ADVANCED CONFIGURATION
# =============================================================================
# Override default ports if needed (uncomment to use)
# CLIENT_PORT=3001
# SERVER_EXTERNAL_PORT=8082
# POSTGRES_PORT=5433
# REDIS_PORT=6380

# Local development database override (uncomment to use)
# DATABASE_URL=postgresql://different_user:password@localhost:5432/different_db

# Production database override (uncomment for production)
# DATABASE_URL=postgresql://prod_user:secure_password@prod-db-host:5432/prod_db