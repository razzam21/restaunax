generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Restaurant {
  id             String         @id @default(uuid())
  name           String
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  primaryColor   String?
  secondaryColor String?
  themeId        String?
  dailyMetrics   DailyMetric[]
  hourlyMetrics  HourlyMetric[]
  itemMetrics    ItemMetric[]
  menuItems      MenuItem[]
  menuCategories MenuCategory[] // New relationship
  orders         Order[]
  users          User[]
  aiJobs         AIJob[]
  aiInsights     AIInsight[]
}

model MenuItem {
  id              String        @id @default(uuid())
  restaurantId    String
  name            String
  description     String?
  price           Float
  category        String?       // Legacy field (kept for backward compatibility)
  categoryId      String?       // New field for relationship
  menuCategory    MenuCategory? @relation(fields: [categoryId], references: [id])
  image           String?       // URL to the image
  dietaryInfo     Json?         // JSON object for dietary information
  isActive        Boolean       @default(true)
  preparationTime Int?          // In minutes
  createdBy       String?       // User ID who created this
  updatedBy       String?       // User ID who last updated this
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  itemMetrics     ItemMetric[]
  restaurant      Restaurant    @relation(fields: [restaurantId], references: [id])
}

// New model for menu categories
model MenuCategory {
  id            String        @id @default(uuid())
  restaurantId  String
  restaurant    Restaurant    @relation(fields: [restaurantId], references: [id])
  name          String
  description   String?
  displayOrder  Int           @default(0) // For sorting
  isActive      Boolean       @default(true)
  menuItems     MenuItem[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@unique([restaurantId, name])
}

model Order {
  id           String      @id @default(uuid())
  restaurantId String
  customerName String
  orderType    OrderType
  status       OrderStatus @default(pending)
  total        Float
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  orderNumber  String?
  userId       String?
  restaurant   Restaurant  @relation(fields: [restaurantId], references: [id])
  user         User?       @relation(fields: [userId], references: [id])
  items        OrderItem[]
}

model OrderItem {
  id         String   @id @default(uuid())
  orderId    String
  name       String
  quantity   Int
  price      Float
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  menuItemId String?
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model User {
  id            String                @id @default(uuid())
  username      String                @unique
  password      String
  role          UserRole              @default(wait_staff)
  restaurantId  String
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  auditLogs     AuditLog[]
  orders        Order[]
  refreshTokens RefreshToken[]
  reportConfigs ReportConfig[]
  restaurant    Restaurant            @relation(fields: [restaurantId], references: [id])
  wsConnections WebSocketConnection[]
  aiJobs        AIJob[]
  systemLogs    SystemLog[]
}

model RefreshToken {
  id        String    @id @default(uuid())
  token     String    @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime  @default(now())
  revoked   Boolean   @default(false)
  revokedAt DateTime?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String
  action    String
  details   Json?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model DailyMetric {
  id                String     @id @default(uuid())
  restaurantId      String
  date              DateTime   @db.Date
  totalOrders       Int        @default(0)
  totalRevenue      Decimal    @default(0) @db.Decimal(10, 2)
  averageOrderValue Decimal    @default(0) @db.Decimal(10, 2)
  averagePrepTime   Decimal?   @db.Decimal(10, 2)
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
  restaurant        Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@unique([restaurantId, date])
}

model HourlyMetric {
  id           String     @id @default(uuid())
  restaurantId String
  date         DateTime   @db.Date
  hour         Int
  orderCount   Int        @default(0)
  revenue      Decimal    @default(0) @db.Decimal(10, 2)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@unique([restaurantId, date, hour])
}

model ItemMetric {
  id              String     @id @default(uuid())
  restaurantId    String
  menuItemId      String
  date            DateTime   @db.Date
  quantity        Int        @default(0)
  revenue         Decimal    @default(0) @db.Decimal(10, 2)
  averagePrepTime Decimal?   @db.Decimal(10, 2)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  menuItem        MenuItem   @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  restaurant      Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@unique([restaurantId, menuItemId, date])
}

model ReportConfig {
  id        String   @id @default(uuid())
  userId    String
  name      String
  type      String
  config    Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model WebSocketConnection {
  id             String   @id @default(uuid())
  userId         String
  connectionId   String   @unique
  clientInfo     Json?
  connectedAt    DateTime @default(now())
  lastActivityAt DateTime @default(now())
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AIJob {
  id               String      @id @default(uuid())
  restaurantId     String
  userId           String
  type             AIJobType
  status           AIJobStatus @default(pending)
  parameters       Json? // Input parameters for the job
  progress         Float       @default(0) // 0-100 percentage
  estimatedCompletion DateTime?
  startedAt        DateTime?
  completedAt      DateTime?
  error            String? // Error message if job failed
  result           Json? // AI analysis result
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  restaurant       Restaurant  @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  user             User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  insight          AIInsight?

  @@index([restaurantId, status])
  @@index([userId])
}

model AIInsight {
  id           String          @id @default(uuid())
  jobId        String          @unique
  restaurantId String
  type         AIInsightType
  title        String
  summary      String
  data         Json // Structured insight data
  confidence   Float // 0-1 confidence score
  validUntil   DateTime? // Optional expiration for insights
  isActive     Boolean         @default(true)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  job          AIJob           @relation(fields: [jobId], references: [id], onDelete: Cascade)
  restaurant   Restaurant      @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId, type])
  @@index([validUntil])
}

model SystemHealth {
  id              String            @id @default(uuid())
  serviceName     String
  status          HealthStatus
  lastCheckAt     DateTime          @default(now())
  responseTime    Int? // Response time in milliseconds
  uptime          BigInt? // Uptime in seconds
  errorCount      Int               @default(0)
  lastError       String?
  metadata        Json? // Additional service-specific data
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@unique([serviceName])
  @@index([status])
  @@index([lastCheckAt])
}

model Container {
  id          String          @id @default(uuid())
  name        String
  status      ContainerStatus
  image       String
  ports       Json? // Port mappings
  startedAt   DateTime?
  restartCount Int            @default(0)
  cpuUsage    Float? // CPU usage percentage
  memoryUsage BigInt? // Memory usage in bytes
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@unique([name])
  @@index([status])
}

model FeatureFlag {
  id          String   @id @default(uuid())
  name        String   @unique
  enabled     Boolean  @default(false)
  description String?
  config      Json? // Additional feature configuration
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([enabled])
}

model SystemLog {
  id        String    @id @default(uuid())
  level     LogLevel
  message   String
  service   String
  timestamp DateTime  @default(now())
  metadata  Json? // Additional log data
  userId    String?
  user      User?     @relation(fields: [userId], references: [id])

  @@index([level])
  @@index([service])
  @@index([timestamp])
  @@index([userId])
}

enum OrderType {
  delivery
  pickup
}

enum OrderStatus {
  pending
  preparing
  ready
  delivered
}

enum UserRole {
  wait_staff
  manager
  owner
}

enum AIJobType {
  demand_forecast
  menu_optimization
  customer_segmentation
}

enum AIJobStatus {
  pending
  running
  completed
  failed
  cancelled
}

enum AIInsightType {
  demand_forecast
  menu_optimization
  customer_segmentation
}

enum HealthStatus {
  healthy
  degraded
  unhealthy
  unknown
}

enum ContainerStatus {
  running
  stopped
  restarting
  paused
  exited
  dead
}

enum LogLevel {
  error
  warn
  info
  debug
}
