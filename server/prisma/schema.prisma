// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "linux-musl"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Restaurant {
  id            String          @id @default(uuid())
  name          String
  themeId       String?         // ID of the theme to use
  primaryColor  String?         // Primary color for the restaurant's theme
  secondaryColor String?        // Secondary color for the restaurant's theme
  orders        Order[]
  menuItems     MenuItem[]
  users         User[]
  dailyMetrics  DailyMetric[]
  hourlyMetrics HourlyMetric[]
  itemMetrics   ItemMetric[]
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
}

model MenuItem {
  id            String          @id @default(uuid())
  restaurantId  String
  restaurant    Restaurant      @relation(fields: [restaurantId], references: [id])
  name          String
  description   String?
  price         Float
  category      String?
  itemMetrics   ItemMetric[]
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
}

model Order {
  id           String      @id @default(uuid())
  orderNumber  String?     // External facing order reference number
  restaurantId String
  restaurant   Restaurant  @relation(fields: [restaurantId], references: [id])
  customerName String
  orderType    OrderType
  status       OrderStatus @default(pending)
  total        Float
  items        OrderItem[]
  userId       String?     // ID of user who created the order
  user         User?       @relation(fields: [userId], references: [id])
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
}

model OrderItem {
  id        String   @id @default(uuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  name      String
  quantity  Int
  price     Float
  menuItemId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum OrderType {
  delivery
  pickup
}

enum OrderStatus {
  pending
  preparing
  ready
  delivered
}

enum UserRole {
  wait_staff
  manager
  owner
}

model User {
  id                String                @id @default(uuid())
  username          String                @unique
  password          String                // Hashed with bcrypt
  role              UserRole              @default(wait_staff)
  restaurantId      String
  restaurant        Restaurant            @relation(fields: [restaurantId], references: [id])
  orders            Order[]
  refreshTokens     RefreshToken[]
  auditLogs         AuditLog[]
  reportConfigs     ReportConfig[]
  wsConnections     WebSocketConnection[]
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
}

model RefreshToken {
  id          String    @id @default(uuid())
  token       String    @unique
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt   DateTime
  createdAt   DateTime  @default(now())
  revoked     Boolean   @default(false)
  revokedAt   DateTime?
}

model AuditLog {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  action      String    // e.g., "login", "update_order", etc.
  details     Json?     // JSON object with action-specific details
  createdAt   DateTime  @default(now())
}

// Models for MVP4: Reports & Dashboard

model DailyMetric {
  id               String     @id @default(uuid())
  restaurantId     String
  restaurant       Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  date             DateTime   @db.Date
  totalOrders      Int        @default(0)
  totalRevenue     Decimal    @default(0) @db.Decimal(10, 2)
  averageOrderValue Decimal   @default(0) @db.Decimal(10, 2)
  averagePrepTime  Decimal?   @db.Decimal(10, 2)
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  @@unique([restaurantId, date])
}

model HourlyMetric {
  id           String     @id @default(uuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  date         DateTime   @db.Date
  hour         Int
  orderCount   Int        @default(0)
  revenue      Decimal    @default(0) @db.Decimal(10, 2)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([restaurantId, date, hour])
}

model ItemMetric {
  id             String     @id @default(uuid())
  restaurantId   String
  restaurant     Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  menuItemId     String
  menuItem       MenuItem   @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  date           DateTime   @db.Date
  quantity       Int        @default(0)
  revenue        Decimal    @default(0) @db.Decimal(10, 2)
  averagePrepTime Decimal?  @db.Decimal(10, 2)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@unique([restaurantId, menuItemId, date])
}

model ReportConfig {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  type      String   // "daily", "weekly", "monthly", "custom"
  config    Json     // Chart configuration, filters, etc.
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model WebSocketConnection {
  id             String   @id @default(uuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  connectionId   String   @unique
  clientInfo     Json?    // Device, browser, etc.
  connectedAt    DateTime @default(now())
  lastActivityAt DateTime @default(now())
}