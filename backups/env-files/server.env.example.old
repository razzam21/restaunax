# Server Environment Configuration
# Copy this file to .env and update values for your environment

# Environment
NODE_ENV=development
PORT=8080

# Database Configuration
# For Docker: postgresql://postgres:postgres@db:5432/restaunax
# For local: postgresql://postgres:postgres@localhost:5432/restaunax
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/restaunax

# CORS Configuration
CORS_ORIGIN=http://localhost:3000

# JWT Configuration
# IMPORTANT: Change these secrets in production!
JWT_ACCESS_SECRET=your-secure-access-secret-key-here
JWT_REFRESH_SECRET=your-secure-refresh-secret-key-here
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Password Hashing
BCRYPT_SALT_ROUNDS=12

# Logging
LOG_LEVEL=info

# AI Feature Configuration (Optional)
# Set OLLAMA_ENABLED=true to enable AI features
OLLAMA_ENABLED=false
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
OLLAMA_TIMEOUT=30000

# Redis Configuration for Job Queue
# For Docker: redis://redis:6379
# For local: redis://localhost:6379
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0